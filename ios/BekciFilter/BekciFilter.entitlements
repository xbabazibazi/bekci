<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Uzantı, uygulamanın yazdığı kuralları OKUYABİLMEK için aynı App
      Group'ta olmalı. Grup kimliği `RuleStore.appGroup` ve uygulamanın
      Bekci.entitlements dosyasıyla birebir aynı olmak zorundadır.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.tr.bekci.shared</string>
    </array>
</dict>
</plist>
